CREATE TABLE IF NOT EXISTS steam_games (
    id               SERIAL PRIMARY KEY,
    snapshot_date    DATE NOT NULL,
    appid            INT NOT NULL,
    name             VARCHAR(255) NOT NULL,
    developer        VARCHAR(255),
    publisher        VARCHAR(255),
